{
  "info": {
    "name": "FundsRoom ERP CRM API",
    "_postman_id": "fundsroom-erp-crm",
    "description": "Core REST API collection for the FundsRoom Mini ERP + CRM portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "PASTE_JWT_TOKEN"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.com\",\"password\":\"password\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Rahul Kumar\",\"mobile\":\"9999999999\",\"email\":\"rahul@example.com\",\"businessName\":\"Rahul Traders\",\"type\":\"WHOLESALE\",\"address\":\"Bengaluru\",\"status\":\"ACTIVE\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Stock In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\":10,\"reason\":\"New stock received\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1",
                "stock"
              ]
            }
          }
        },
        {
          "name": "Stock Movements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/stock-movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "stock-movements"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "Create Multi-Product Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\":1,\"status\":\"DRAFT\",\"items\":[{\"productId\":1,\"quantity\":5},{\"productId\":2,\"quantity\":3}]}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ]
            }
          }
        },
        {
          "name": "List Challans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ]
            }
          }
        },
        {
          "name": "Confirm Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/1/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                "1",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Cancel Draft Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/1/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                "1",
                "cancel"
              ]
            }
          }
        }
      ]
    }
  ]
}