# Backend

# PostgreSQL connection string (replace with your own database credentials)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT signing secret (generate a long random value)
JWT_SECRET="replace-with-a-long-random-secret"

# Port the backend server listens on
PORT=5000

# Frontend

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:5000
